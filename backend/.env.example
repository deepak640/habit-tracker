# MongoDB connection string. Use a MongoDB Atlas URI when deploying to Vercel.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/habit-tracker?retryWrites=true&w=majority
PORT=3000
# Google AI Studio key for the Diet chat (https://aistudio.google.com/apikey). Optional: GEMINI_MODEL, comma-separated fallbacks (default gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash).
GEMINI_API_KEY=
